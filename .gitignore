!data/models/*/MODEL.json
!data/models/registry.json
!data/models/registry.json.sig
!data/datasets/
data/datasets/*
!data/datasets/*/
data/datasets/*/*
!data/datasets/*/DATASET.json
secrets/
Log/
__pycache__/
*.pyc
.pytest_cache/
reports/raw/
*.egg-info/
*.zip
