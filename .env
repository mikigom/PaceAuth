COMPOSE_FILE=docker-compose.yml:deploy/compose.platform.yml:deploy/compose.search.yml:deploy/compose.api.yml:deploy/compose.engine.yml
# Deployed recognizer and thresholds (E2: best 1:N; FA_T_ID = extrapolated FPIR 1e-6 @ 100k x 4 threshold 0.567,
# rounded up: maximum gallery 100,000 customers, decided 2026-10-11; reports/E2_1N/adaface_ir101_wf12m/capacity_100000.json)
FA_RECOG_MODEL=adaface_ir101_wf12m
FA_T_ID=0.57
FA_MARGIN=0.10
FA_T_DUP=0.45
FA_T_SAME=0.68
