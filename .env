COMPOSE_FILE=docker-compose.yml:deploy/compose.platform.yml:deploy/compose.search.yml:deploy/compose.api.yml:deploy/compose.engine.yml
FA_GPU_DEVICE_ID=0
# Bound per-replica scratch/activation memory on this 8 GB RTX 4060.
FA_ENGINE_DET_SESSIONS=1
FA_ENGINE_RECOG_BATCH_SIZE=8
FA_ENGINE_POSE_BATCH_SIZE=8
# Live sensor UI is reachable from the local network; no Internet publication.
FA_LIVE_BIND_IP=0.0.0.0
FA_LIVE_PORT=8080
# Stable AMD iGPU path for the camera depth engine (independent of NVIDIA inference).
FA_DRM_RENDER_NODE=/dev/dri/by-path/pci-0000:0b:00.0-render
# Verified synchronized RGB-D-IR profile on the USB 3.1 link and AMD depth renderer.
FA_ORBBEC_FPS=30
# Explicit user-requested LAN pilot: face recognition runs without PAD.
FA_PILOT_DISABLE_PAD=1
# Deployed recognizer and thresholds (E2: best 1:N; FA_T_ID = extrapolated FPIR 1e-6 @ 100k x 4 threshold 0.567,
# rounded up: maximum gallery 100,000 customers, decided 2026-10-11; reports/E2_1N/adaface_ir101_wf12m/capacity_100000.json)
FA_RECOG_MODEL=adaface_ir101_wf12m
FA_T_ID=0.57
FA_MARGIN=0.10
FA_T_DUP=0.45
FA_T_SAME=0.68
